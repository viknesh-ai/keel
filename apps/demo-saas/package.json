{
  "name": "@keel/demo-saas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Northwind Cloud — the demo product Keel governs, and the fixture the test suite runs against.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "verify:operations": "tsx scripts/verify-operations.ts",
    "dev:web": "vite --config web/vite.config.ts web",
    "build:web": "vite build --config web/vite.config.ts web"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@keel/scripts": "workspace:*",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "yaml": "^2.6.1",
    "@keel/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "@keel/identity": "workspace:*",
    "@keel/react": "workspace:*",
    "@keel/client": "workspace:*",
    "@keel/node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
