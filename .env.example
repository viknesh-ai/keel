# Copy to .env and adjust. Never commit .env.
# Nothing here is required to start the infrastructure stack — a fresh
# `docker compose up` works with these defaults and no API keys.

# ---- Infrastructure ----
POSTGRES_USER=keel
POSTGRES_PASSWORD=keel
POSTGRES_DB=keel
POSTGRES_PORT=5432
DATABASE_URL=postgres://keel:keel@localhost:5432/keel

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=keel
MINIO_ROOT_PASSWORD=keelkeel
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=keel

# ---- Platform ----
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
DASHBOARD_PORT=3000

# Signing key for action tokens. Generate with `keel init` once the CLI exists.
# Until then this is unused. Never reuse a development key in production.
KEEL_SIGNING_KEY_PATH=./.keys/action-token.ed25519

# ---- Model providers ----
# Optional. The default self-host profile uses local embeddings and will start
# without any of these. Set only the providers you intend to route to.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint, e.g. Ollama or vLLM
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=keel-api
